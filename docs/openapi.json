          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Delete a backup archive"
      }
    },
    "/api/v1/backups/list.json": {
      "get": {
        "operationId": "listBackups",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BackupListResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "List backup archives"
      }
    },
    "/api/v1/backups/restore.json": {
      "post": {
        "operationId": "restoreBackup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BackupRestoreRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Restore a SQLite snapshot backup"
      }
    },
