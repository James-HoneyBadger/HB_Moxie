    "/api/v1/transactions/splits/index.json": {
      "get": {
        "operationId": "getTransactionSplitIndex",
        "parameters": [
          {
            "description": "Minimum transaction time in milliseconds",
            "in": "query",
            "name": "min_time",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Maximum transaction time in milliseconds, 0 for no upper bound",
            "in": "query",
            "name": "max_time",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TransactionSplitIndexItem"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successful response"
          }
        },
