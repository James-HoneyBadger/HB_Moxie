  "info": {
    "description": "Self-hosted personal finance API exposed by the local Honey Ledger backend.",
    "title": "Honey Ledger API",
    "version": "1.4.3"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/authorize.json": {
      "post": {
        "operationId": "authorize",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Log in with username or email and password"
      }
    },
    "/api/auto_login.json": {
      "post": {
        "operationId": "autoLogin",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Log in the single desktop user without a password"
      }
    },
    "/api/v1/backups/create.json": {
      "post": {
        "operationId": "createBackup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BackupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackupListResponse"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "Create a SQLite snapshot backup"
      }
    },
    "/api/v1/backups/delete.json": {
      "post": {
        "operationId": "deleteBackup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BackupDeleteRequest"
              }
            }
          },
          "required": true
        },
