{
  "name": "honey-ledger-desktop",
  "version": "1.4.3",
  "description": "Honey Ledger — private, local-first personal finance management",
  "homepage": "https://github.com/James-HoneyBadger/honey-ledger",
  "main": "main.js",
  "author": {
    "name": "Honey Badger Universe",
    "email": "James-HoneyBadger@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.honeybadger.honeyledger",
    "publish": [
      {
        "provider": "github",
        "owner": "James-HoneyBadger",
        "repo": "honey-ledger"
      }
    ],
    "productName": "Honey Ledger",
    "artifactName": "honey-ledger-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../",
        "to": "backend/",
        "filter": [
          "honey-ledger",
          "honey-ledger.exe"
        ]
      },
      {
        "from": "../conf",
        "to": "backend/conf"
      },
      {
        "from": "../templates",
        "to": "backend/templates"
      },
      {
        "from": "../dist",
        "to": "backend/public"
      }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "Finance"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.icns",
      "category": "public.app-category.finance"
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico"
    }
  }
}
