{
  "name": "ratel-ledger-desktop",
  "version": "1.4.1",
  "description": "Ratel Ledger — private, local-first personal finance management",
  "main": "main.js",
  "author": "Honey Badger Universe",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.honeybadger.ratelledger",
    "productName": "Ratel Ledger",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../",
        "to": "backend/",
        "filter": [
          "ratel-ledger",
          "ratel-ledger.exe"
        ]
      },
      {
        "from": "../conf",
        "to": "backend/conf"
      },
      {
        "from": "../templates",
        "to": "backend/templates"
      },
      {
        "from": "../dist",
        "to": "backend/public"
      }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "Finance"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.icns",
      "category": "public.app-category.finance"
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico"
    }
  }
}
